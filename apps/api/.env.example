NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rewards
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=rewards-api
JWT_AUDIENCE=rewards-web
APP_ORIGIN=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
MIN_WITHDRAWAL_POINTS=5000
MAX_SINGLE_REWARD_POINTS=10000000
REFERRAL_COMMISSION_BPS=1000
STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=rewards-proof
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_BASE_URL=https://cdn.example.com
